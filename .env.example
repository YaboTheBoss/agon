# SpacetimeDB connection (defaults shown). Point these at Maincloud for a hosted DB.
NEXT_PUBLIC_SPACETIMEDB_URI=ws://localhost:3010
NEXT_PUBLIC_SPACETIMEDB_DB=yaapi-dev

# Google sign-in: OAuth 2.0 Client ID (Web application) from Google Cloud Console.
# Also add it to GOOGLE_CLIENT_IDS in spacetimedb/src/auth.ts and republish.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only Gemini key used by the debate judging panel. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional server-to-server credential for trusted backend calls to the judging route.
# Generate a long random value. Mobile/web clients should use their Google ID token instead.
YAAPI_JUDGE_INTERNAL_KEY=
